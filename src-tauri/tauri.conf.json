{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folia Lyric Studio",
  "version": "0.1.0",
  "identifier": "com.kyuu-charlie.folia-lyric-studio",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Folia Lyric Studio", "width": 1440, "height": 920, "minWidth": 900, "minHeight": 640, "resizable": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "category": "Video", "shortDescription": "Desktop lyric video editor", "longDescription": "A local-first desktop workspace for editing timed lyrics and exporting lyric videos." }
}
